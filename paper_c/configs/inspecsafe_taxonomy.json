{
  "_doc": [
    "Hazard primitives and per-industry severity for InspecSafe-V1.",
    "Severity is a risk index: 3 = Level one (critical), 2 = Level two, 1 = Level three, 0 = not a hazard in that industry.",
    "Source: the 'Assessment Criteria (by industry)' table in the official InspecSafe-V1 evaluation prompt (model_api_generate_results.py).",
    "Primitives absent from an industry's row default to 0; scene-level leak terms in the aggregator absorb hazards outside this list.",
    "industry_prefix_rules map the inspection-point folder prefix to an industry; scripts/build_index.py lists unmapped prefixes - add them here."
  ],
  "levels": {
    "risk_index_to_name": [
      "no abnormalities observed",
      "Level three",
      "Level two",
      "Level one"
    ],
    "risk_index_to_roman": [
      "IV",
      "III",
      "II",
      "I"
    ]
  },
  "industries": [
    "oil_gas",
    "coal_conveyor",
    "tunnel",
    "power",
    "metallurgy"
  ],
  "industry_prefix_rules": [
    {
      "contains": "coal",
      "industry": "coal_conveyor"
    },
    {
      "contains": "tunnel",
      "industry": "tunnel"
    },
    {
      "contains": "power",
      "industry": "power"
    },
    {
      "contains": "substation",
      "industry": "power"
    },
    {
      "contains": "sinter",
      "industry": "metallurgy"
    },
    {
      "contains": "metal",
      "industry": "metallurgy"
    },
    {
      "contains": "steel",
      "industry": "metallurgy"
    },
    {
      "contains": "oil",
      "industry": "oil_gas"
    },
    {
      "contains": "gas",
      "industry": "oil_gas"
    },
    {
      "contains": "chem",
      "industry": "oil_gas"
    },
    {
      "contains": "petro",
      "industry": "oil_gas"
    }
  ],
  "primitives": [
    {
      "id": "open_flame",
      "question": "Is there an open flame or fire visible in the image?",
      "pos": [
        "open flame",
        "\\bflames?\\b",
        "\\bfire\\b(?!\\s*(cabinet|extinguisher|hydrant|door|hose|alarm|box|fighting|protection|pipe|sprinkler|escape|exit|safety|equipment|station|detector))",
        "burning"
      ],
      "neg": [],
      "negatable": true
    },
    {
      "id": "smoke",
      "question": "Is there smoke that indicates a fire or an abnormal emission? Ignore normal process smoke or steam, such as from a slag pot or furnace.",
      "pos": [
        "\\bsmoke\\b(?!\\s*detector)",
        "smoky"
      ],
      "neg": [],
      "negatable": true
    },
    {
      "id": "personnel_collapse",
      "question": "Is there a person who has collapsed, fallen, or is lying on the ground?",
      "pos": [
        "collaps",
        "lying on the (ground|floor)",
        "fallen (person|worker)",
        "(person|worker|personnel) (has )?fallen",
        "(person|worker|personnel|someone)[^.;]{0,15}\\bon the (ground|floor)",
        "\\bfallen\\b"
      ],
      "neg": [],
      "negatable": true
    },
    {
      "id": "smoking",
      "question": "Is there a person smoking (holding a lit cigarette) in the image?",
      "pos": [
        "\\bsmoking\\b",
        "cigarette"
      ],
      "neg": [],
      "negatable": true
    },
    {
      "id": "oil_leakage",
      "question": "Is oil actively leaking, dripping, or spraying from equipment or pipes?",
      "pos": [
        "oil leak",
        "leaking oil",
        "oil (is )?dripping",
        "oil spray",
        "oil spill"
      ],
      "neg": [],
      "negatable": true
    },
    {
      "id": "no_hard_hat",
      "question": "Is there a person who is not wearing a hard hat (safety helmet)?",
      "pos": [
        "(?:\\b(?:not|never|n't)\\s+(?:be\\s+)?(?:wearing|wear|worn|equipped with)|\\bwithout|\\black(?:ing|s)?|\\bno)\\b(?:(?!\\bbut\\b|\\bwhile\\b|\\balthough\\b|\\bhowever\\b)[^.;]){0,60}?\\b(?:hard hats?|safety helmets?|helmets?|safety hats?)",
        "\\b(?:hard hats?|safety helmets?|helmets?|safety hats?)\\s+(?:is |are )?(?:missing|absent|not worn)"
      ],
      "neg": [
        "\\b(?:wearing|wears|with)\\b(?:(?!\\bbut\\b|\\bwhile\\b|\\balthough\\b|\\bhowever\\b)[^.;]){0,60}?\\b(?:hard hats?|safety helmets?|helmets?|safety hats?)"
      ],
      "negatable": false
    },
    {
      "id": "no_gloves",
      "question": "Is there a person who is not wearing protective gloves?",
      "pos": [
        "(?:\\b(?:not|never|n't)\\s+(?:be\\s+)?(?:wearing|wear|worn|equipped with)|\\bwithout|\\black(?:ing|s)?|\\bno)\\b(?:(?!\\bbut\\b|\\bwhile\\b|\\balthough\\b|\\bhowever\\b)[^.;]){0,60}?\\b(?:protective |work )?gloves?",
        "\\b(?:protective |work )?gloves?\\s+(?:is |are )?(?:missing|absent|not worn)"
      ],
      "neg": [
        "\\b(?:wearing|wears|with)\\b(?:(?!\\bbut\\b|\\bwhile\\b|\\balthough\\b|\\bhowever\\b)[^.;]){0,60}?\\b(?:protective |work )?gloves?"
      ],
      "negatable": false
    },
    {
      "id": "no_mask",
      "question": "Is there a person who is not wearing a face mask?",
      "pos": [
        "(?:\\b(?:not|never|n't)\\s+(?:be\\s+)?(?:wearing|wear|worn|equipped with)|\\bwithout|\\black(?:ing|s)?|\\bno)\\b(?:(?!\\bbut\\b|\\bwhile\\b|\\balthough\\b|\\bhowever\\b)[^.;]){0,60}?\\b(?:face |dust )?masks?",
        "\\b(?:face |dust )?masks?\\s+(?:is |are )?(?:missing|absent|not worn)"
      ],
      "neg": [
        "\\b(?:wearing|wears|with)\\b(?:(?!\\bbut\\b|\\bwhile\\b|\\balthough\\b|\\bhowever\\b)[^.;]){0,60}?\\b(?:face |dust )?masks?"
      ],
      "negatable": false
    },
    {
      "id": "mobile_phone",
      "question": "Is there a person using a mobile phone?",
      "pos": [
        "(mobile|cell)? ?phone",
        "smartphone"
      ],
      "neg": [],
      "negatable": true
    },
    {
      "id": "water_pooling",
      "question": "Is there pooled or standing water on the floor or ground?",
      "pos": [
        "water pool",
        "pooling",
        "puddle",
        "standing water",
        "accumulated water",
        "water accumulation",
        "liquid accumulation",
        "accumulat\\w* (of )?(water|liquid)"
      ],
      "neg": [],
      "negatable": true
    },
    {
      "id": "oil_accumulation",
      "question": "Is there accumulated oil or an oil stain on the floor or equipment?",
      "pos": [
        "oil accumulation",
        "accumulated oil",
        "oil stain",
        "oil (puddle|pool)",
        "oily"
      ],
      "neg": [],
      "negatable": true
    },
    {
      "id": "foreign_object_light",
      "question": "Are there foreign objects such as plastic bags, plastic bottles, foam, or paper lying around?",
      "pos": [
        "plastic bag",
        "plastic bottle",
        "\\bbottles?\\b",
        "\\bfoam\\b",
        "\\bpaper\\b",
        "debris",
        "foreign object",
        "litter",
        "garbage",
        "trash",
        "\\bbags?\\b"
      ],
      "neg": [],
      "negatable": true
    },
    {
      "id": "foreign_object_hard",
      "question": "Are there foreign objects such as pieces of wood or metal lying where they should not be?",
      "pos": [
        "\\bwood(en)? (piece|plank|block|board)s?",
        "\\bwood\\b",
        "metal (piece|object|scrap|rod|bar|debris)s?",
        "scrap metal"
      ],
      "neg": [],
      "negatable": true
    },
    {
      "id": "cabinet_door_open",
      "question": "Is there an electrical or equipment cabinet door left open?",
      "pos": [
        "cabinet door (is |left )?open",
        "open cabinet",
        "door of the cabinet (is )?open",
        "cabinet door[^.;]{0,25}\\bopen",
        "\\bdoor[^.;]{0,20}\\b(abnormally )?open(ed)?\\b"
      ],
      "neg": [
        "cabinet door (is |are )?(closed|shut)"
      ],
      "negatable": true
    },
    {
      "id": "nonmotor_vehicle",
      "question": "Is there a non-motorized vehicle (such as a bicycle or tricycle) in a vehicle lane?",
      "pos": [
        "bicycle",
        "\\bbike\\b",
        "tricycle",
        "non-motori[sz]ed vehicle",
        "electric scooter"
      ],
      "neg": [],
      "negatable": true
    }
  ],
